# ---- Hermes (복사: ~/.hermes/profiles/hyojason/.env) ----
API_SERVER_ENABLED=true
API_SERVER_KEY=change-me-long-random
ANTHROPIC_API_KEY=              # Hermes 모델 호출용 (config.example.yaml 의 model 블록)
AI_GATEWAY_KEY=                 # Cloudflare AI Gateway 토큰 (Anthropic 키는 게이트웨이에 저장)

# ---- MCP: shopping_tools ----
NAVER_CLIENT_ID=                # developers.naver.com > 내 애플리케이션 > 검색(쇼핑)
NAVER_CLIENT_SECRET=
TYPESAFE_API_KEY=               # Jev (TypeSafe System One) — console.typesafe.ai
HYOJASON_CLIENTS_DIR=./clients
COUPANG_ACCESS_KEY=              # 쿠팡 파트너스 Open API (승인 후). 비어 있으면 쿠팡에 요청하지 않음
COUPANG_SECRET_KEY=
COUPANG_PARTNERS_VERIFIED=       # 미검증 코드. 파트너스 공식 문서와 대조를 마친 뒤에만 1

# ---- kakao-bridge (Cloudflare Worker: wrangler secret put) ----
HERMES_API_URL=https://<tunnel>.trycloudflare.com   # Mac 의 hermes gateway 로 가는 터널
HERMES_API_KEY=                 # = API_SERVER_KEY
KAKAO_BOT_SECRET=               # 브릿지가 카카오 요청인지 확인할 때 쓸 임의 값 (선택)
